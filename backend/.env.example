# BorrowBox FastAPI backend configuration
# Copy to .env (or export as environment variables) and adjust as needed.

# SQLite database file location (defaults to backend/data/borrowbox.db)
BORROWBOX_DATABASE_URL="sqlite:///./data/borrowbox.db"

# Secret used to sign JWT access tokens. Generate a long random string, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated at startup (tokens reset on restart).
BORROWBOX_SECRET_KEY=""

# JWT lifetime in minutes (default: 7 days)
BORROWBOX_JWT_EXPIRES_MINUTES=10080

# Comma-separated CORS origins allowed to call the API
BORROWBOX_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ---------------------------------------------------------------------------
# Google OAuth 2.0 (optional). Leave blank to disable Google sign-in.
# Values come from a "Web application" OAuth client in Google Cloud Console.
# The client secret must ONLY live here (backend env) — never in the frontend.
# ---------------------------------------------------------------------------

# OAuth client ID, e.g. 1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_ID=""

# OAuth client secret (keep private; do not commit a real value)
GOOGLE_CLIENT_SECRET=""

# Must exactly match an "Authorized redirect URI" on the Google OAuth client.
# Uses the actual backend host/port and API prefix.
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/api/v1/auth/google/callback"

# Where the browser returns after Google sign-in. Only this origin is ever
# used for redirects (prevents open-redirect abuse).
BORROWBOX_FRONTEND_URL="http://localhost:3000"
